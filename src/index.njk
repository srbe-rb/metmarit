      <div class="contact-lines">
        <span><strong>Mail</strong> <a href="mailto:metmarit@gmail.com">metmarit@gmail.com</a></span>
        <span><strong>Bel</strong> <a href="tel:+31651495471">+31 6 51495471</a></span>
      </div>
